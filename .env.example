# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project settings -> Database -> Connection string -> "Direct
# connection" URI, port 5432. (We'll switch to the pooled connection when
# deploying to serverless/Vercel; the pooler can't run migrations.)
DATABASE_URL=

# Anthropic API key, for AI check-in summaries (added in a later phase)
ANTHROPIC_API_KEY=

# Resend API key, for check-in invite/reminder emails (added in a later phase)
RESEND_API_KEY=
